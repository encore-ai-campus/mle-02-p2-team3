# Copy to .env; use real credentials locally and never commit .env.
# Only configure services needed for your chosen workflow.
DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
NEO4J_URI=neo4j+s://HOST.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j
OPENAI_API_KEY=replace-me

# Optional settings
# OPENAI_MODEL=your-model-id
# RECIPE_QUERY_LOG=0
# RECIPE_DB_DIAGNOSTIC=0
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SECRET_KEY=replace-me
