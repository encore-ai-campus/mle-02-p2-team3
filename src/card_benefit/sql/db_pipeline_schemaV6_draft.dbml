  card_doc_chunk_id varchar(20) [not null, unique, note: '청크 아이디']
  chunk_seq integer [not null, note: '청크 순번']
  chunk_section_nm text [note: '절 제목']
  chunk_type_cd varchar(20) [not null, note: '청크 유형']
  chunk_start_pos integer [not null, note: '청크 시작 위치']
  chunk_end_pos integer [not null, note: '청크 종료 위치']
  chunk_raw_txt text [not null, note: '청크 원문']
  chunk_clean_txt text [note: '청크 정제문']
  chunk_status varchar(20) [not null, note: '청크 상태']
  chunk_split_rule_ver varchar(50) [not null, note: '청크 분리 규칙 버전']
  chunk_clean_rule_ver varchar(50) [note: '청크 정제 규칙 버전']
