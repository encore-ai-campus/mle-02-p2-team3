  run_call_mthd_cd varchar(20) [not null, note: 'AI 호출 방식']
  run_model_nm varchar(100) [not null, note: '모델명']
  run_prompt_ver varchar(50) [not null, note: '프롬프트 버전']
  run_prompt_txt text [not null, note: '프롬프트 원문']
  run_param jsonb [note: '모델 파라미터']
  run_target_card_doc_id varchar(20) [note: '대상 문서 아이디']
  run_status varchar(20) [not null, note: '실행 상태']
  run_start_date timestamptz [not null, note: '실행 시작 일시']
  run_end_date timestamptz [note: '실행 종료 일시']
  run_note text [note: '실행 메모']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
}

Table db_pipeline.card_ai_call [note: 'AI 호출 이력'] {
  card_ai_run_id varchar(20) [not null, note: 'AI 실행 아이디']
  card_doc_id varchar(20) [not null, note: '문서 아이디']
  page_no smallint [not null, note: '페이지 번호']
  card_doc_chunk_id varchar(20) [not null, note: '청크 아이디']
  call_seq smallint [not null, note: '호출 순번']
  call_input_sha256 varchar(64) [not null, note: '호출 입력 해시']
  call_status varchar(20) [not null, note: '호출 상태']
  call_resp_raw text [note: '응답 원문']
  call_resp_json jsonb [note: '응답 JSON']
  call_error_msg text [note: '오류 메시지']
  call_input_token_cnt integer [note: '입력 토큰 수']
  call_output_token_cnt integer [note: '출력 토큰 수']
  call_latency_ms integer [note: '응답 시간']
  call_req_date timestamptz [not null, note: '요청 일시']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
  Indexes {
    (card_ai_run_id, card_doc_id, page_no, card_doc_chunk_id, call_seq) [pk]
  }
}

Table db_pipeline.card_extr_stg [note: 'AI 추출 항목'] {
  card_ai_run_id varchar(20) [not null, note: 'AI 실행 아이디']
  card_doc_id varchar(20) [not null, note: '문서 아이디']
  page_no smallint [not null, note: '페이지 번호']
  card_doc_chunk_id varchar(20) [not null, note: '청크 아이디']
  call_seq smallint [not null, note: '호출 순번']
  card_extr_stg_id varchar(20) [not null, unique, note: '추출 항목 아이디']
  stg_item_seq smallint [not null, note: '추출 항목 순번']
  card_id bigint [not null, note: '카드 아이디']
  stg_kind_cd varchar(20) [not null, note: '추출 항목 종류']
  stg_parent_card_extr_stg_id varchar(20) [note: '상위 추출 항목 아이디']
  stg_raw_item jsonb [not null, note: '추출 원본']
  stg_normalized_item jsonb [note: '정제 항목']
  stg_evidence_txt text [not null, note: '추출 근거 문장']
  stg_evidence_start_pos integer [note: '근거 시작 위치']
  stg_evidence_end_pos integer [note: '근거 종료 위치']
  card_excl_item_id varchar(20) [note: '제외 항목 아이디']
  stg_sql_check_cd varchar(30) [note: 'SQL 검증 결과']
  stg_ai_vrfy_cd varchar(20) [note: 'AI 검증 결과']
  stg_ai_vrfy_card_ai_run_id varchar(20) [note: 'AI 검증 실행 아이디']
  stg_status varchar(20) [not null, note: '검토 상태']
  stg_review_note text [note: '검토 메모']
  stg_approved_date timestamptz [note: '승인 일시']
  stg_approved_user_id varchar(50) [note: '승인 사용자 아이디']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
  Indexes {
    (card_ai_run_id, card_doc_id, page_no, card_doc_chunk_id, call_seq, card_extr_stg_id) [pk]
    (card_ai_run_id, card_doc_id, page_no, card_doc_chunk_id, call_seq, stg_item_seq) [unique]
  }
}

Table db_pipeline.card_excl_item [note: '제외 항목 사전'] {
  card_excl_item_id varchar(20) [not null, pk, note: '제외 항목 아이디']
  issuer text [not null, note: '카드사']
  excl_item_nm text [not null, note: '제외 항목명']
  excl_concept_cd varchar(50) [note: '제외 분류 개념']
  excl_item_desc text [note: '제외 항목 설명']
  excl_alias_nms "text[]" [not null, note: '제외 항목 별칭']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
  Indexes {
    (issuer, excl_item_nm) [unique]
  }
}

Ref: db_pipeline.common_code_grp.common_code_grp_id < db_pipeline.common_cd.common_code_grp_id
Ref: db_pipeline.card_product.card_id < db_pipeline.card_policy_version.card_id
Ref: db_pipeline.card_product.card_id < db_pipeline.card_product_doc.card_id
Ref: db_pipeline.card_doc.card_doc_id < db_pipeline.card_product_doc.card_doc_id
Ref: db_pipeline.card_policy_version.(card_id, policy_ver_id) < db_pipeline.card_bnft.(card_id, policy_ver_id)
Ref: db_pipeline.card_policy_version.(card_id, policy_ver_id) < db_pipeline.card_limit_pool.(card_id, policy_ver_id)
Ref: db_pipeline.card_common_bnft.common_bnft_id < db_pipeline.card_common_policy_version.common_bnft_id
Ref: db_pipeline.card_bnft.(card_id, policy_ver_id, card_bnft_id) < db_pipeline.card_bnft_common.(card_id, policy_ver_id, card_bnft_id)
Ref: db_pipeline.card_common_policy_version.(common_bnft_id, common_ver_id) < db_pipeline.card_bnft_common.(common_bnft_id, common_ver_id)
Ref: db_pipeline.card_policy_version.(card_id, policy_ver_id) < db_pipeline.card_policy_evidence.(card_id, policy_ver_id)
Ref: db_pipeline.card_bnft.(card_id, policy_ver_id, card_bnft_id) < db_pipeline.card_policy_evidence.(card_id, policy_ver_id, card_bnft_id)
Ref: db_pipeline.card_limit_pool.(card_id, policy_ver_id, pool_id) < db_pipeline.card_policy_evidence.(card_id, policy_ver_id, pool_id)
Ref: db_pipeline.card_source_evidence.evidence_id < db_pipeline.card_policy_evidence.evidence_id
Ref: db_pipeline.card_common_policy_version.(common_bnft_id, common_ver_id) < db_pipeline.card_common_rule_evidence.(common_bnft_id, common_ver_id)
Ref: db_pipeline.card_source_evidence.evidence_id < db_pipeline.card_common_rule_evidence.evidence_id
Ref: db_pipeline.card_doc_chunk.(card_doc_id, page_no, card_doc_chunk_id) < db_pipeline.card_source_evidence.(card_doc_id, page_no, card_doc_chunk_id)
Ref: db_pipeline.card_extr_stg.card_extr_stg_id < db_pipeline.card_source_evidence.card_extr_stg_id
Ref: db_pipeline.card_doc.card_doc_id < db_pipeline.card_doc_page.card_doc_id
Ref: db_pipeline.card_doc_page.(card_doc_id, page_no) < db_pipeline.card_doc_chunk.(card_doc_id, page_no)
Ref: db_pipeline.card_product.card_id < db_pipeline.card_doc.card_id
Ref: db_pipeline.card_doc.card_doc_id < db_pipeline.card_ai_run.run_target_card_doc_id
Ref: db_pipeline.card_ai_run.card_ai_run_id < db_pipeline.card_ai_call.card_ai_run_id
Ref: db_pipeline.card_doc_chunk.(card_doc_id, page_no, card_doc_chunk_id) < db_pipeline.card_ai_call.(card_doc_id, page_no, card_doc_chunk_id)
Ref: db_pipeline.card_ai_call.(card_ai_run_id, card_doc_id, page_no, card_doc_chunk_id, call_seq) < db_pipeline.card_extr_stg.(card_ai_run_id, card_doc_id, page_no, card_doc_chunk_id, call_seq)
Ref: db_pipeline.card_product.card_id < db_pipeline.card_extr_stg.card_id
Ref: db_pipeline.card_excl_item.card_excl_item_id < db_pipeline.card_extr_stg.card_excl_item_id
Ref: db_pipeline.card_ai_run.card_ai_run_id < db_pipeline.card_extr_stg.stg_ai_vrfy_card_ai_run_id
Ref: db_pipeline.card_extr_stg.card_extr_stg_id < db_pipeline.card_extr_stg.stg_parent_card_extr_stg_id

TableGroup common_code {
  db_pipeline.common_code_grp
  db_pipeline.common_cd
}

TableGroup product_policy {
  db_pipeline.card_product
  db_pipeline.card_product_doc
  db_pipeline.card_policy_version
}

TableGroup product_benefit {
  db_pipeline.card_bnft
  db_pipeline.card_limit_pool
  db_pipeline.card_method_catalog
}

TableGroup common_benefit {
  db_pipeline.card_common_bnft
  db_pipeline.card_common_policy_version
  db_pipeline.card_bnft_common
}

TableGroup source_evidence {
  db_pipeline.card_source_evidence
  db_pipeline.card_policy_evidence
  db_pipeline.card_common_rule_evidence
}

TableGroup source_document {
  db_pipeline.card_doc
  db_pipeline.card_doc_page
  db_pipeline.card_doc_chunk
}

TableGroup ai_parsing {
  db_pipeline.card_ai_run
  db_pipeline.card_ai_call
  db_pipeline.card_extr_stg
  db_pipeline.card_excl_item
}
