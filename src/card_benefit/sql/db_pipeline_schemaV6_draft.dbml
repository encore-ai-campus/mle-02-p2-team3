  bnft_cd varchar(80) [not null, note: '혜택 코드']
  bnft_nm text [not null, note: '혜택명']
  bnft_type_cd varchar(20) [not null, note: '혜택 유형']
  bnft_origin_cd varchar(20) [not null, note: '혜택 출처']
  bnft_scope_cd varchar(20) [not null, note: '혜택 적용 범위']
  bnft_brand_opt_cds "text[]" [note: '적용 브랜드 선택지']
  bnft_cond_expr jsonb [note: '혜택 적용 조건']
  rule_select_cd varchar(30) [note: '규칙 선택 방식']
  rule_list jsonb [not null, note: '계산 규칙 목록']
  relation_list jsonb [not null, note: '혜택 관계 목록']
  verification_status_cd varchar(25) [not null, note: '혜택 검증 상태']
  Indexes {
    (card_id, policy_ver_id, card_bnft_id) [pk]
    (card_id, policy_ver_id, bnft_cd) [unique]
  }
}

