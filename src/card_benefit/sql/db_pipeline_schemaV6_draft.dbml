// V6 draft physical-column mirror of db_pipeline_schemaV6_draft.sql. Generated from the executed DDL catalog.
// Ref lines are logical only; SQL has 0 FKs.
// JSONB references cannot be drawn as Ref lines. They are logical references checked by v_card_integrity_issue:
//   card_bnft.rule_list[].pool_refs[].pool_id        -> card_limit_pool.pool_id
//   card_bnft.relation_list[].to_bnft_id             -> card_bnft.card_bnft_id
//   card_bnft.relation_list[].trigger_pool_id        -> card_limit_pool.pool_id
//   card_policy_evidence.rule_key                    -> card_bnft.rule_list[].rule_key
//   card_policy_evidence.relation_key                -> card_bnft.relation_list[].relation_key
//   card_common_rule_evidence.rule_key               -> card_common_policy_version.rule_list[].rule_key
//   card_policy_version.source_doc_list[].card_doc_id -> card_doc.card_doc_id
//   rule_list[].(calc_method_cd, method_ver)         -> card_method_catalog.(method_cd, method_ver)
// Code columns reference common_cd. The group of each column is defined by the view v_common_cd_usage.

Table db_pipeline.common_code_grp [note: '공통코드 그룹'] {
  common_code_grp_id varchar(20) [not null, pk, note: '공통코드 그룹 아이디']
  common_code_grp_nm text [not null, note: '공통코드 그룹명']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
}

Table db_pipeline.common_cd [note: '공통코드'] {
  common_code_grp_id varchar(20) [not null, note: '공통코드 그룹 아이디']
  common_cd varchar(40) [not null, note: '공통코드']
  common_cd_nm text [not null, note: '공통코드명']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
  Indexes {
    (common_code_grp_id, common_cd) [pk]
  }
}

Table db_pipeline.card_product [note: '카드 상품'] {
  card_id bigint [not null, pk, note: '카드 아이디']
  product_cd varchar(80) [not null, unique, note: '상품 코드']
  product_nm text [not null, note: '상품명']
  issuer varchar(50) [not null, note: '카드사']
  card_kind_cd varchar(10) [not null, note: '카드 구분']
  product_status_cd varchar(20) [not null, note: '상품 상태']
  launched_on date [note: '출시일']
  discontinued_on date [note: '판매 중단일']
  brand_opt_list jsonb [not null, note: '브랜드 선택지 목록']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
}

Table db_pipeline.card_product_doc [note: '상품별 문서 관계'] {
  card_id bigint [not null, note: '카드 아이디']
  card_doc_id varchar(20) [not null, note: '문서 아이디']
  doc_role_cd varchar(20) [not null, note: '문서 역할']
  brand_opt_cds "text[]" [note: '적용 브랜드 선택지']
  effective_from date [note: '문서 적용 시작일']
  effective_to_excl date [note: '문서 적용 종료일']
  approval_status_cd varchar(20) [not null, note: '승인 상태']
  applicability_basis_txt text [not null, note: '적용 근거']
  approval_note text [note: '승인 메모']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
  update_user_id varchar(50) [not null, note: '수정 사용자 아이디']
  Indexes {
    (card_id, card_doc_id) [pk]
  }
}

Table db_pipeline.card_policy_version [note: '카드 정책 버전'] {
  card_id bigint [not null, note: '카드 아이디']
  policy_ver_id varchar(20) [not null, note: '정책 버전 아이디']
  policy_ver_no integer [not null, note: '정책 버전 번호']
  policy_cond_expr jsonb [note: '카드 공통 조건']
  source_doc_list jsonb [not null, note: '근거 문서 목록']
  valid_from date [not null, note: '적용 시작일']
  valid_to_excl date [note: '적용 종료일']
  approved_at timestamptz [note: '승인 일시']
  policy_status_cd varchar(20) [not null, note: '정책 상태']
  Indexes {
    (card_id, policy_ver_id) [pk]
    (card_id, policy_ver_no) [unique]
  }
}

