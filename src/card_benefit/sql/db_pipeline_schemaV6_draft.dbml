  doc_version_no smallint [not null, note: '문서 버전 번호']
  doc_status varchar(20) [not null, note: '문서 상태']
  doc_note text [note: '문서 메모']
  create_date timestamptz [not null, note: '생성 일시']
  create_user_id varchar(50) [not null, note: '생성 사용자 아이디']
  update_date timestamptz [not null, note: '수정 일시']
