# Streamlit Community Cloud > App settings > Secrets에 아래 형식으로 입력한다(값은 실제 값으로 바꾼다).
# 로컬에서 쓰려면 이 파일을 같은 폴더의 secrets.toml로 복사한다. secrets.toml은 커밋하지 않는다(.gitignore).
# 로컬은 secrets.toml이 없으면 저장소 루트 .env를 사용한다.

NEO4J_URI = "neo4j+s://<instance-id>.databases.neo4j.io"   # 인증서 검증 유지(+ssc 스킴은 거부됨)
NEO4J_USERNAME = "<username>"
NEO4J_PASSWORD = "<password>"
NEO4J_DATABASE = "<database>"                              # 선택. 없으면 서버 기본 DB

OPENAI_API_KEY = "<openai-api-key>"                        # 선택. 없거나 실패하면 규칙 기반 설명으로 표시
OPENAI_MODEL = "gpt-6-luna"                                # 선택. 기본값 gpt-6-luna
